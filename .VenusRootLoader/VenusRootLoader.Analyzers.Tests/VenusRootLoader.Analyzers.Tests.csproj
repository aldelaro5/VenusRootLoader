<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <NoWarn>NU1701;NU1702;MSB3277</NoWarn>
        <!-- We only pull MonoMod transitively as a side effect, but we do not use it so this check is irrelevant here. -->
        <MonoMod_ReallySkipCheckTargetRuntime>true</MonoMod_ReallySkipCheckTargetRuntime>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.dotCover.Framework" Version="1.0.2"/>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.12.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0"/>
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0"/>
        <PackageReference Include="Microsoft.Testing.Extensions.Telemetry" Version="2.5.3"/>
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0"/>
        <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.3"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\VenusRootLoader.Analyzers\VenusRootLoader.Analyzers.csproj"/>
        <ProjectReference Include="..\VenusRootLoader\VenusRootLoader.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Content Update="xunit.runner.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
