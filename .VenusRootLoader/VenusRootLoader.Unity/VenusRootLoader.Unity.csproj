<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <LangVersion>latest</LangVersion>
        <LangVersion>7.3</LangVersion>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All"/>
        <PackageReference Include="BugFables.GameLibs" Version="120.0.0" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
      <Compile Include="../../Editor/Attributes/*.cs" LinkBase="Attributes" />
      <Compile Include="../../Editor/Enums/*.cs" LinkBase="Enums" />
      <Compile Include="../../Editor/ScriptableObjects/*.cs" LinkBase="ScriptableObjects" />
    </ItemGroup>
</Project>
